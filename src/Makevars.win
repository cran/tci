
## Build settings for tci (Windows)
##
## This package requires C++17 (see DESCRIPTION: SystemRequirements: C++17).
## Rtools43/44 toolchains used by R >= 4.2.0 provide C++17 support.
##
## OpenMP: Armadillo can use OpenMP when available. The SHLIB_OPENMP_* flags
## are included below. On Windows, these are provided by the toolchain.
##
## Do not alter PKG_*FLAGS here unless you know your BLAS/LAPACK setup.
## Keep CXX_STD in sync with the Rcpp plugin annotation in src/*.cpp.
CXX_STD = CXX17

PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS) 
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)
